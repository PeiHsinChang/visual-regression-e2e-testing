# Copy to brand-a/.env and fill in real values.
# brand-a/.env is gitignored.

# Storefront base URL that playwright.brand-a.config.ts points at.
# Required for brand-a tests to resolve relative URLs.
BASE_URL=https://brand-a.local.test

# Optional: milliseconds to slow down every Playwright action for debugging.
# Any non-zero value also forces headed mode so you can watch.
# SLOW_MO=250
