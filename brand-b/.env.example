# Copy to brand-b/.env and fill in real values.
# brand-b/.env is gitignored.

# Storefront base URL that playwright.brand-b.config.ts points at.
# Required for brand-b tests to resolve relative URLs.
BASE_URL=https://brand-b.local.test

# Credentials for the "logged-in" (OSC) checkout and account tests.
# Required by brand-b/tests/helpers.ts (loginViaStorefront, clearCartViaRest).
# Use a dedicated test account on a non-production environment.
OSC_TEST_EMAIL=test@example.com
OSC_TEST_PASSWORD=change-me
